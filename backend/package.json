    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^11.0.2",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.17.2",
    "resend": "^6.39.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
