  "description": "MiSalud.Imedic — BFF del portal del paciente (Express + mssql)",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
