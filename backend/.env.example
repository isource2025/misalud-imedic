# ─── General ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5010
# true = todo en memoria + clínicas, RENAPER y emails simulados. Prohibido con NODE_ENV=production.
MOCK_MODE=true
# URL pública del front (links de los emails y chequeo de Origin). Varias separadas por coma en CORS_ORIGINS.
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=https://misalud.imedic.com.ar
# Saltos de proxy delante del back (Railway = 1) para obtener la IP real en el rate limit.
TRUST_PROXY=1

# ─── Secretos (obligatorios en producción; generá cada uno con: openssl rand -base64 48) ──
SESSION_JWT_SECRET=
OPAQUE_ID_KEY=
CODE_PEPPER=
ACCESS_TOKEN_MIN=10
SESSION_IDLE_MIN=30
SESSION_MAX_HOURS=12

# ─── Base propia del portal (SQL Server en Railway) ─────────────────────────
PORTAL_DB_SERVER=
PORTAL_DB_PORT=1433
PORTAL_DB_NAME=MiSaludPortal
PORTAL_DB_USER=
PORTAL_DB_PASSWORD=
PORTAL_DB_ENCRYPT=true
PORTAL_DB_TRUST_CERT=false

# ─── Clínicas habilitadas ───────────────────────────────────────────────────
# Qué clínicas se publican lo decide siempre la tabla EmpresasPortal (Habilitada = 1).
# portal = solo EmpresasPortal; ubicación de cada clínica en CLINICA_<ID>_*.
# imedic = además lee la vista vw_MiSaludEmpresas del MySQL de plataforma de iMedic (script S5) para nombre,
#          servidor/base SQL, FileServerUrl y PacsUrl. Nunca la tabla Empresas.
EMPRESAS_SOURCE=portal
# CATALOGO_DB_HOST=
# CATALOGO_DB_PORT=3306
# CATALOGO_DB_NAME=railway
# CATALOGO_DB_USER=misalud_catalogo_ro
# CATALOGO_DB_PASSWORD=
# CATALOGO_DB_SSL=false
CLINICA_TIMEOUT_MS=8000
CLINICA_CACHE_SEG=180

# SQL Server de cada clínica con el login de SOLO LECTURA misalud_portal_ro (script S4, contraseña distinta
# por clínica). Con EMPRESAS_SOURCE=imedic, SERVER/PORT/INSTANCE/NAME salen del catálogo y estas los pisan.
# La contraseña va SOLO acá (nunca en Empresas de iMedic).
# CLINICA_DB_USER_DEFAULT=misalud_portal_ro
# Sarmiento (101)
# CLINICA_101_DB_PASSWORD=
# CLINICA_101_DB_SERVER=
# CLINICA_101_DB_PORT=51433
# CLINICA_101_DB_NAME=
# CLINICA_101_DB_INSTANCE=
# CLINICA_101_DB_ENCRYPT=false
# CLINICA_101_DB_TRUST_CERT=true
# Güemes / Sanatorio Materno Infantil (103)
# CLINICA_103_DB_PASSWORD=

# ─── File server / PACS de las clínicas (Fase 2: adjuntos e imágenes) ───────
# Firma x-imedic-sig por clínica, mismo esquema y MISMAS claves que iMedic SaaS (signedFileToken.js).
# Usar una de las dos: clave maestra (se deriva la de cada clínica) o mapa explícito por IDEMPRESA.
# IMEDIC_SIGNING_MASTER=
# FILE_SERVER_SIGNING_KEYS={"101":"clave"}
# PACS_SIGNING_KEYS={"101":"clave"}
# FILE_SERVER_SIGNING_TTL_S=120
# PACS_SIGNING_TTL_S=120
# URLs: salen de vw_MiSaludEmpresas; estas las pisan (útil sin catálogo).
# CLINICA_101_FILE_SERVER_URL=https://files-sarmiento.imedic.com.ar
# CLINICA_101_PACS_URL=https://pacs-sarmiento.imedic.com.ar

# ─── Identidad (RENAPER solo con número de DNI) ─────────────────────────────
# imedic-proxy = endpoint de iMedic SaaS GET /api/integrations/bot/renaper/:dni. mock = simulado.
RENAPER_MODE=imedic-proxy
RENAPER_PROXY_BASE_URL=https://api.imedic.com.ar/api/integrations/bot
RENAPER_PROXY_API_KEY=
RENAPER_PROXY_EMPRESA_ID=
RENAPER_TIMEOUT_MS=20000

# ─── Emails (motor de IOSCOR) ───────────────────────────────────────────────
MAIL_DISPLAY_NAME=MiSalud
# auto = Resend si está configurado, si no SMTP. console = imprime en la consola (desarrollo).
EMAIL_TRANSPORT=auto
RESEND_API_KEY=
RESEND_FROM=MiSalud <no-reply@imedic.com.ar>
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@imedic.com.ar

# ─── Solo mock ──────────────────────────────────────────────────────────────
# Simula clínicas caídas (ids separados por coma) para ver el aviso "no disponible".
# MOCK_CLINICA_CAIDA=101
